{
  "manifest_version": 3,
  "name": "Memoreply — Workspace Memory & Smart Composer",
  "description": "Context-driven communication assistant for client-facing professionals by HashTurn.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Memoreply"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fiverr.com/*",
        "https://fiverr.com/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "cookies",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.fiverr.com/*",
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
