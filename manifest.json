{
  "manifest_version": 3,
  "name": "Memoreply — Workspace Ledger & Response Composer",
  "description": "Deterministic context engine and communication ledger for client-facing professionals by HashTurn.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Memoreply",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fiverr.com/*",
        "https://fiverr.com/*",
        "*://*.upwork.com/*",
        "https://upwork.com/*",
        "*://*.linkedin.com/*",
        "https://linkedin.com/*",
        "https://memoreply.com/*",
        "https://*.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.fiverr.com/*",
    "*://*.upwork.com/*",
    "*://*.linkedin.com/*",
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "https://*.vercel.app/*",
    "https://memoreply.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
