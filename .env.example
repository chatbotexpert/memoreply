# ============================================================
# Memoreply — Environment Variables Template
# ============================================================

# OpenAI API Key (starts with sk-proj-... or sk-...)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
NODE_ENV=development

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL="https://memoreply.com"

# Supabase Credentials (PostgreSQL Database & Admin SDK)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:password@pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@pooler.supabase.com:5432/postgres"

# Clerk Authentication (clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Resend Transactional Email API Key & Sender
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Memoreply Cloud <onboarding@resend.dev>"

# Cloud Sync Secret Gateway Token
SYNC_GATEWAY_SECRET="memo_live_your_gateway_secret"
