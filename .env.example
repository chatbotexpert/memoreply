# ============================================================
# Memoreply — Environment Variables Template
# ============================================================
# Note: For production use in the Chrome Extension, the OpenAI
# API key is securely entered and stored inside the extension's
# Settings tab (stored locally in chrome.storage.local).
#
# This file is provided for local automated testing scripts.
# ============================================================

# OpenAI API Key (starts with sk-proj-... or sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Default OpenAI Model (e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Extension Environment
NODE_ENV=development
